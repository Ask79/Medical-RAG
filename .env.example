# ---- DailyMed ----
DM_MASTER_PATH=/path/to/dailymed/master.jsonl
DM_META_PATH=/path/to/dailymed/meta.jsonl
DM_CHUNKS_PATH=/path/to/dailymed/chunks.jsonl

# ---- RxNorm ----
RXNORM_MASTER_PATH=/path/to/rxnorm/rx_master.jsonl
RXNORM_REL_PATH=/path/to/rxnorm/rx_rel.jsonl
RXNORM_SAT_PATH=/path/to/rxnorm/rx_sat.jsonl

# ---- SNOMED ----
SNOMED_MASTER_PATH=/path/to/snomed/master.jsonl
SNOMED_CHUNKS_PATH=/path/to/snomed/chunks.jsonl

# ---- Crosswalks / Links ----
SPL_RXCUI_PATH=/path/to/links/daily_rx_links_resolved.jsonl

# ---- Embeddings / Indices (if used) ----
EMBEDDINGS_DIR=/path/to/embeddings
INDEX_DIR=/path/to/indices
